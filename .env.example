# Copiar a .env y completar. La configuración llega a los contenedores por
# variables de entorno; ningún archivo .env se copia a las imágenes.

# ── Base de datos (MySQL del contenedor) ──
# Contraseña del root de MySQL. Obligatoria para arrancar compose.
MYSQL_ROOT_PASSWORD=
# Usuario con el que se conecta la aplicación (el contenedor lo crea con
# privilegios sólo sobre facturacion_db). La contraseña también es obligatoria.
FACTURACION_DB_USER=facturacion
FACTURACION_DB_PASS=
# FACTURACION_DB_HOST y FACTURACION_DB_NAME los fija compose (db / facturacion_db).

# ── Correo (Gmail) ──
# La aplicación envía por smtp.gmail.com:587 con STARTTLS, por lo que las
# credenciales deben ser de una cuenta Gmail. Requiere una «contraseña de
# aplicación» de exactamente 16 caracteres (Cuenta de Google → Seguridad →
# Verificación en dos pasos → Contraseñas de aplicaciones). Sin ellas, los
# correos quedan en cola como pendientes; el resto del sistema funciona.
FACTURACION_SMTP_USUARIO=
FACTURACION_SMTP_CLAVE=
# Destinatario de las alertas de acceso y del correo de prueba del panel.
FACTURACION_CORREO_JEFE=
# Opcional; si se define debe coincidir con FACTURACION_SMTP_USUARIO.
#FACTURACION_CORREO_REMITENTE=

# ── Docker ──
# Puerto del host para la app en el perfil dev (por defecto 8080).
#APP_PORT=8080
# Puerto del host para el proxy TLS de docker-compose.prod.yml (8444; el 8443
# corresponde a la pila del proyecto DAW).
#HTTPS_PORT=8444
# Nombre común (CN) del certificado autofirmado que genera tls-certs-init:
# un nombre DNS o una IP, p. ej. la dirección del servidor en la red local.
#TLS_CN=localhost
